{# Smart luxury stock + satisfaction (no raw counts, no stars). Uses only Salla product fields; hidden when data is missing. #}
{% set q = product.quantity %}
{% set sold = product.sold_quantity ?? 0 %}
{% if q is null %}{% set lv = 'high' %}{% set sv = 96 %}
{% elseif q <= 0 %}{% set lv = 'out' %}{% set sv = 0 %}
{% elseif q <= 3 %}{% set lv = 'last' %}{% set sv = 12 %}
{% elseif q <= 10 %}{% set lv = 'low' %}{% set sv = 34 %}
{% elseif q <= 30 %}{% set lv = 'mid' %}{% set sv = 62 %}
{% else %}{% set lv = 'high' %}{% set sv = 90 %}{% endif %}
{% set lvT = {'high':'متوفر بثقة','mid':'توفر جيد','low':'الكمية تقل','last':'آخر القطع','out':'نفدت · نبّهني'} %}
{% set lvD = {'high':'جاهز للشحن اليوم','mid':'يُنصح بالطلب قريباً','low':'الطلب عليه مرتفع هذا الأسبوع','last':'قد ينفد خلال ساعات','out':'نرسل لك فور توفره'} %}
<div class="tp" data-testid="tech-pulse">
  <div class="tp-card tp-stock tp-{{ lv }}">
    <div class="tp-gauge" style="--v:{{ sv }}"><i></i></div>
    <div><span class="tp-k">نبض المخزون</span><b>{{ lvT[lv] }}</b><small>{{ lvD[lv] }}{% if sold > 20 %} · <em class="tp-hot">رائج</em>{% endif %}</small></div>
  </div>
  {% if product.rating and product.rating.count > 0 %}
    {% set pc = (product.rating.stars / 5 * 100)|round %}
    {% set n = product.rating.count %}
    {% set verdict = pc >= 90 ? 'رضا استثنائي' : (pc >= 80 ? 'رضا عالٍ' : (pc >= 65 ? 'رضا جيد' : 'آراء متباينة')) %}
    {% set conf = n >= 50 ? 'ثقة عالية' : (n >= 10 ? 'ثقة متوسطة' : 'آراء أولية') %}
    <a href="#comments" class="tp-card tp-sat">
      <div class="ig-ring gold tp-ring" style="--v:{{ pc }}"><b>{{ pc }}<small>%</small></b></div>
      <div><span class="tp-k">مؤشر رضا العملاء</span><b>{{ verdict }}</b><small><span class="tp-conf tp-c{{ n >= 50 ? 3 : (n >= 10 ? 2 : 1) }}"><i></i><i></i><i></i></span>{{ conf }} · من مشترين فعليين</small></div>
    </a>
  {% endif %}
</div>
