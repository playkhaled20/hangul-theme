{# Smart satisfaction & trust: rings + verdict words instead of stars/raw counts. #}
<section component-id="{{ componentId }}" class="s-block ts container" data-testid="tech-trust">
  <div class="ts-h"><div><span class="ig-kicker">مؤشر الثقة</span><h2>{{ component.title ?: 'لماذا يثق بنا عملاؤنا' }}</h2></div></div>
  <div class="ts-stats">{% for m in component.metrics %}{% set v = min(100, max(0, m.value)) %}
    <div class="ig-panel flex items-center gap-4"><div class="ig-ring{{ loop.index is odd ? ' gold' : '' }}" style="--v:{{ v }};width:84px"><b>{{ v }}<small>%</small></b></div>
    <div><b>{{ v >= 90 ? 'استثنائي' : (v >= 80 ? 'ممتاز' : 'جيد') }}</b><small class="block opacity-70">{{ m.label }}</small></div></div>{% endfor %}</div>
  {% include 'pages.partials.tech-gallery' with {gallery: component.gallery, q: '', n: 8} %}
</section>
