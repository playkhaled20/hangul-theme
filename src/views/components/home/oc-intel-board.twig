{# Hangul · Store intelligence board — a live infographic of the merchant's real store (departments, price range,
   stock readiness, offers, rating, catalogue mix, leading brands). Tiles without real data are not shown.
   6–12 backdrop images play as a slow cinematic strip behind the data. #}
{% set list = component.backdrops ?: [] %}{% set have = list|length %}
{% set demo = ['electronics-bundle','computers-bundle','phones-bundle','audio-bundle','gaming-bundle','cameras-bundle'] %}
<section component-id="{{ componentId }}" class="s-block oc-bd container" data-oc-sec="board" data-testid="oc-intel-board" hidden>
  <div class="oc-bd__film" aria-hidden="true">
    {% for b in list %}<img src="{{ b.image }}" alt="" loading="lazy">{% endfor %}
    {% if have < 6 %}{% for i in have..5 %}<img data-oc-demo="img" data-oc-fill src="{{ ('images/oc/' ~ demo[i] ~ '.webp')|asset }}" alt="" loading="lazy">{% endfor %}{% endif %}
  </div>
  <header class="oc-head" data-k="LIVE"><div><span class="oc-chip"><span class="oc-dot"></span>{{ trans('oc.live') }}</span><h2 class="oc-metal">{{ component.title ?: trans('oc.board_title') }}</h2></div><p>{{ component.subtitle ?: trans('oc.board_sub') }}</p></header>
  <div class="oc-bd__grid" data-oc-board></div>
</section>
