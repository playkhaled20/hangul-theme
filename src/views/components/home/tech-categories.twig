{# Tech categories grid — covers all Salla tech categories; each item links to a Salla category or falls back to search. #}
<section component-id="{{ componentId }}" class="s-block ts container" data-testid="tech-categories">
  <div class="ts-h"><div><span class="ig-kicker">{{ component.kicker ?: 'تسوّق حسب الفئة' }}</span><h2>{{ component.title ?: 'كل عالم التقنية' }}</h2></div></div>
  <div class="ts-cats">
  {% for c in component.cats %}
    {% set u = c.url is iterable ? (c.url.url ?? '') : c.url %}
    <a class="ts-cat" href="{{ u ?: ('/search?q=' ~ c.title|url_encode) }}">{% include 'pages.partials.tech-icon' with {i: c.icon is iterable ? (c.icon|first).value ?? 'spark' : c.icon} %}<b>{{ c.title }}</b></a>
  {% endfor %}
  </div>
  {% include 'pages.partials.tech-gallery' with {gallery: component.gallery, q: '', n: 12} %}
</section>
