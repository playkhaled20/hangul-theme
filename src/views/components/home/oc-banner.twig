{# Hangul · merchant promo banner(s): image, mobile image, title, subtitle, button, link. Multilanguage text. #}
{% set h = (component.height is iterable ? (component.height|first).value : component.height) ?: 'md' %}
<section component-id="{{ componentId }}" class="s-block oc-banner container oc-banner--{{ h }}" data-testid="oc-banner">
  {% for b in component.banners %}
  <a class="oc-banner__item" href="{{ b.url ?: '#' }}">
    <picture>{% if b.image_mobile %}<source media="(max-width:640px)" srcset="{{ b.image_mobile }}">{% endif %}<img src="{{ b.image }}" alt="{{ b.title ?: store.name }}" loading="lazy"></picture>
    {% if b.title or b.subtitle or b.cta %}<span class="oc-banner__copy">{% if b.title %}<b class="oc-metal">{{ b.title }}</b>{% endif %}{% if b.subtitle %}<em>{{ b.subtitle }}</em>{% endif %}{% if b.cta %}<i class="oc-btn">{{ b.cta }}</i>{% endif %}</span>{% endif %}
  </a>
  {% endfor %}
</section>
