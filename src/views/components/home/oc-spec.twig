{# Hangul · Spec infographic — exploded view. 6–12 shots, each = image + spec label + optional score + hotspot (x,y %).
   Optional real product (name/price/link fetched live). Demo rows use the detected type's spec words; no invented scores. #}
{% set list = component.shots ?: [] %}{% set have = list|length %}
{% set demo = ['phones-featured','computers-featured','audio-featured','cameras-featured','watches-featured','gaming-featured','smarthome-featured','electronics-featured','accessories-featured','phones-bundle','computers-bundle','audio-bundle'] %}
{% set pid = component.product is iterable ? ((component.product|first).id ?? (component.product|first).value ?? '') : component.product %}
<section component-id="{{ componentId }}" class="s-block oc-spec container" data-oc-sec="spec" data-product="{{ pid }}" data-testid="oc-spec">
  <header class="oc-head" data-k="SPEC"><div><span class="oc-chip"><i class="oc-chip__ic" data-oc-vicon aria-hidden="true"></i>{{ component.kicker ?: trans('oc.spec_kicker') }}</span><h2 class="oc-metal">{{ component.title ?: trans('oc.spec_title') }}</h2></div>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</header>
  <div class="oc-spec__grid">
    <div class="oc-spec__stage" data-oc-reveal>
      {% for s in list %}
      <figure class="oc-spec__shot"><img src="{{ s.image }}" alt="{{ s.label }}" loading="lazy">
        <span class="oc-hot" style="--x:{{ s.x ?? 50 }}%;--y:{{ s.y ?? 50 }}%"><i></i><em class="oc-glass"><b>{{ s.label }}</b>{% if s.note %}<small>{{ s.note }}</small>{% endif %}</em></span></figure>
      {% endfor %}
      {% if have < 6 %}{% for i in have..5 %}
      <figure class="oc-spec__shot" data-oc-demo="img"><img data-oc-fill src="{{ ('images/oc/' ~ demo[i] ~ '.webp')|asset }}" alt="" loading="lazy">
        <span class="oc-hot" style="--x:{{ [38,62,50,30,70,55][i] }}%;--y:{{ [40,45,58,35,60,30][i] }}%"><i></i></span></figure>
      {% endfor %}{% endif %}
      <span class="oc-spec__scan" aria-hidden="true"></span><span class="oc-spec__grid-lines" aria-hidden="true"></span>
      <div class="oc-spec__product" data-oc-spec-product></div>
    </div>
    <ol class="oc-spec__rows">
      {% for s in list %}
      <li class="oc-spec__row" tabindex="0" data-oc-reveal><span class="oc-spec__n">{{ '%02d'|format(loop.index) }}</span><div><b>{{ s.label }}</b>{% if s.note %}<small>{{ s.note }}</small>{% endif %}
        {% if s.value %}<div class="oc-meter"><i style="--w:{{ s.value }}%"></i></div>{% endif %}</div>{% if s.value %}<em data-oc-count="{{ s.value }}">0</em>{% endif %}</li>
      {% endfor %}
      {% if have < 6 %}{% for i in have..5 %}
      <li class="oc-spec__row" tabindex="0" data-oc-demo="img" data-oc-reveal><span class="oc-spec__n">{{ '%02d'|format(have + loop.index) }}</span><div><b data-oc-fill-t>{{ trans('oc.spec_title') }}</b></div></li>
      {% endfor %}{% endif %}
    </ol>
  </div>
</section>
