{# Obsidian Cinema · cinematic infographic hero with trust gauges + stock meters. Stats: merchant figures, else live figures measured from the store (never invented). #}
<section component-id="{{ componentId }}" class="s-block oc-hero container" data-testid="oc-hero">
  <div class="oc-hero__stage">
    <div class="oc-hero__media">
      {% if component.image %}<img src="{{ component.image }}" alt="{{ component.title }}" loading="eager">{% else %}<div class="oc-hero__orb" aria-hidden="true"><i></i><i></i><i></i><span class="oc-hero__art" data-oc-hero-art></span></div><div class="oc-hud oc-glass"><header><small>SPEC·HUD</small><b data-oc-vname></b></header><div data-oc-hud></div></div>{% endif %}
    </div>
    <div class="oc-hero__copy">
      <span class="oc-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>{{ component.kicker ?: trans('oc.hero_kicker') }}</span>
      <h1 class="oc-metal"{% if not component.title %} data-oc-store-name{% endif %}>{{ component.title ?: store.name }}</h1>
      <h2 class="oc-sub" data-oc-hero-sub{% if component.subtitle %} data-custom="1"{% endif %}>{{ component.subtitle ?: trans('oc.hero_sub') }}</h2>
      {% if component.description %}<p>{{ component.description }}</p>{% endif %}
      <a class="oc-btn" href="{{ component.url ?: link('/') }}">{{ component.cta ?: trans('oc.explore') }} <span aria-hidden="true">←</span></a>
    </div>
  </div>
  <div class="oc-hero__gauges">
    <div class="oc-live"><span>{{ trans('oc.stock_update') }}</span><b class="oc-metal">{{ trans('oc.live') }}</b><small data-oc-clock>{{ trans('oc.updated_now') }}</small></div>
    {% if component.stats|length %}
    {% for s in component.stats %}{% set v = s.value ?? s['stats.value'] ?? 0 %}
      <div class="oc-gauge" style="--v:{{ v }}">
        <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="t" cx="18" cy="18" r="15.9"/><circle class="v" cx="18" cy="18" r="15.9" pathLength="100"/></svg>
        <b>{{ v }}%</b><span>{{ s.label ?? s['stats.label'] }}</span><small>{{ s.note ?? s['stats.note'] }}</small>
      </div>
    {% endfor %}
    {% else %}
    {# no merchant figures → live, measured store figures (hidden when the store has no data for them) #}
    {% for g in [['inStock', trans('oc.stock'), trans('oc.availability')], ['onSale', trans('oc.deal'), trans('oc.deal_live')], ['rating', trans('oc.trust'), trans('oc.trust_level')]] %}
      <div class="oc-gauge" data-oc-live="{{ g[0] }}" style="--v:0" hidden>
        <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="t" cx="18" cy="18" r="15.9"/><circle class="v" cx="18" cy="18" r="15.9" pathLength="100"/></svg>
        <b>—</b><span>{{ g[1] }}</span><small>{{ g[2] }}</small>
      </div>
    {% endfor %}
    {% endif %}
  </div>
</section>
