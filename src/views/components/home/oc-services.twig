{# Hangul · After-sale journey (6–12 steps with images). Demo steps link to the merchant's own policy pages
   found in the footer; the theme never writes policy terms itself. #}
{% set list = component.steps ?: [] %}{% set have = list|length %}
{% set demo = ['electronics-bundle','phones-featured','accessories-bundle','digital_cards-featured','audio-bundle','smarthome-bundle'] %}
{% set dt = [['svc_ship','svc_ship_n','shipping'],['svc_unbox','svc_unbox_n','warranty'],['svc_ret','svc_ret_n','returns'],['svc_pay','svc_pay_n','payment'],['svc_help','svc_help_n','contact'],['svc_setup','svc_setup_n','about']] %}
<section component-id="{{ componentId }}" class="s-block oc-svc container" data-oc-sec="services" data-testid="oc-services">
  <header class="oc-head" data-k="CARE"><h2 class="oc-metal">{{ component.title ?: trans('oc.svc_title') }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</header>
  <ol class="oc-svc__line">
    {% for s in list %}<li class="oc-svc__step" data-oc-reveal><figure><img src="{{ s.image }}" alt="" loading="lazy"><span>{{ '%02d'|format(loop.index) }}</span></figure><b>{{ s.title }}</b><p>{{ s.text }}</p>{% if s.url %}<a href="{{ s.url }}">{{ trans('oc.more') }}</a>{% endif %}</li>{% endfor %}
    {% if have < 6 %}{% for i in have..5 %}<li class="oc-svc__step" data-oc-demo="img" data-policy="{{ dt[i][2] }}" data-oc-reveal><figure><img data-oc-fill src="{{ ('images/oc/' ~ demo[i] ~ '.webp')|asset }}" alt="" loading="lazy"><span>{{ '%02d'|format(have + loop.index) }}</span></figure><b>{{ trans('oc.' ~ dt[i][0]) }}</b><p>{{ trans('oc.' ~ dt[i][1]) }}</p><a data-oc-pol hidden></a></li>{% endfor %}{% endif %}
  </ol>
</section>
