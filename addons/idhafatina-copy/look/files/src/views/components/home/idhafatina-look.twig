{% set fk_t = theme.settings.get('idhafatina_store_type', 'auto') %}{% if fk_t is iterable %}{% set fk_t = fk_t.value is defined ? fk_t.value : fk_t|first %}{% endif %}{% if fk_t is iterable %}{% set fk_t = 'auto' %}{% endif %}{% set fk = {'men': 'fashion', 'abaya': 'fashion', 'kids': 'fashion', 'fashion': 'fashion', 'jewelry': 'fashion', 'furniture': 'hm', 'textiles': 'hm', 'gifts': 'gf'}[fk_t]|default('gen') %}
{% set bk = {'abaya': 'fashion', 'jewelry': 'fashion', 'furniture': 'hm', 'gifts': 'gf', 'kids': 'fashion', 'men': 'fashion', 'shoesbags': 'fashion', 'textiles': 'hm'}[fk_t]|default('gen') %}{% set nn_s = trans('idhafatina.nn.' ~ fk_t) %}{% if nn_s matches '/^[^|]*$/' %}{% set nn_s = trans('idhafatina.nn.general') %}{% endif %}{% set nn = nn_s|split('|') %}{% set sl = {'@s': nn[2], '@p': nn[3], '@i': nn[0], '@d': nn[1], '@y': nn[4], '@m': nn[5], '@n': nn[6], '@t': nn[7], '@l': nn[8]} %}
{% set default_outfits = [
{ 'name': trans('idhafatina.look.c1'), 'hex': '#24201E', 'match': trans('idhafatina.look.m1'), 'note': trans('idhafatina.fam.gen_look_n1')|replace(sl) },
{ 'name': trans('idhafatina.look.c2'), 'hex': '#F5F1EA', 'match': trans('idhafatina.look.m2'), 'note': trans('idhafatina.fam.gen_look_n2')|replace(sl) },
{ 'name': trans('idhafatina.look.c3'), 'hex': '#D9C3A5', 'match': trans('idhafatina.look.m3'), 'note': trans('idhafatina.fam.gen_look_n3')|replace(sl) },
{ 'name': trans('idhafatina.look.c4'), 'hex': '#22304F', 'match': trans('idhafatina.look.m4'), 'note': trans('idhafatina.fam.gen_look_n4')|replace(sl) },
{ 'name': trans('idhafatina.look.c5'), 'hex': '#E7B6BE', 'match': trans('idhafatina.look.m5'), 'note': trans('idhafatina.fam.gen_look_n5')|replace(sl) },
{ 'name': trans('idhafatina.look.c6'), 'hex': '#4E6B55', 'match': trans('idhafatina.look.m6'), 'note': trans('idhafatina.fam.gen_look_n6')|replace(sl) },
{ 'name': trans('idhafatina.look.c7'), 'hex': '#6E2433', 'match': trans('idhafatina.look.m7'), 'note': trans('idhafatina.fam.gen_look_n7')|replace(sl) },
{ 'name': trans('idhafatina.look.c8'), 'hex': '#9B9893', 'match': trans('idhafatina.look.m8'), 'note': trans('idhafatina.fam.gen_look_n8')|replace(sl) }
] %}
{% set is_def = component.outfits is empty %}{% set outfits = component.outfits|default(default_outfits) %}
{% if outfits is empty %}{% set outfits = default_outfits %}{% endif %}
<section component-id="{{ componentId }}" class="idhafatina-look idhafatina-sec" id="idhafatina-look" data-idhafatina="look" data-thread="0.955">
<div class="idhafatina-wrap">
<header class="idhafatina-head">
<span class="idhafatina-eyebrow">{% set kk = component.eyebrow|default(trans('idhafatina.fam.' ~ fk ~ '_look_e')) %}<span class="latin{{ kk matches '/[A-Za-z]/' ? '' : ' k-ar' }}" data-fk="look_e"{% if component.eyebrow %} data-m{% endif %}>{{ kk }}</span></span>
{%set tpk%}{%include 'components.idhafatina-tp' with {s:'look'}%}{%endset%}{%set tpk=tpk|split('¦')%}
<h2 class="idhafatina-split" data-fk="look_t"{% if component.title or tpk[1] is defined %} data-m{% endif %}{% if tpk[1] is defined %} data-tp="{{ tpk[0] }}"{% endif %}>{{ tpk[1] ?? component.title|default(trans('idhafatina.fam.' ~ fk ~ '_look_t')) }}</h2>
<p data-fk="look_d"{% if component.description %} data-m{% endif %}>{{ component.description|default(trans('idhafatina.fam.' ~ fk ~ '_look_d')) }}</p>
</header>
<div class="idhafatina-look-grid">
<div class="idhafatina-look-stage">
<div class="idhafatina-look-arch">
<svg class="gown gown-dress" viewBox="0 0 300 520" aria-hidden="true">
<defs><linearGradient id="idhafatina-gownShade-{{ position }}" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity=".22"/><stop offset=".35" stop-color="#fff" stop-opacity=".12"/><stop offset=".6" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".28"/></linearGradient></defs>
<g class="lk-hg" fill="none" style="stroke:var(--gold)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M150 18a10 10 0 1 1 10 10c-6 0-10 4-10 9v13M150 50L92 82h116z"/></g>
<g class="gown-fill"><path class="lk-m" d="M118 80c8 10 20 16 32 16s24-6 32-16l22 10c4 2 6 6 6 10l-6 86-14 10 4 50c22 76 46 160 60 270H46c14-110 38-194 60-270l4-50-14-10-6-86c0-4 2-8 6-10z"/></g>
<path class="lk-m" d="M118 80c8 10 20 16 32 16s24-6 32-16l22 10c4 2 6 6 6 10l-6 86-14 10 4 50c22 76 46 160 60 270H46c14-110 38-194 60-270l4-50-14-10-6-86c0-4 2-8 6-10z" fill="url(#idhafatina-gownShade-{{ position }})"/>
<path class="lk-d" d="M110 196h80" style="stroke:var(--gold)" stroke-width="3" stroke-opacity=".8" fill="none"/>
</svg>
<figure class="idhafatina-look-bag"><img alt=""></figure>
</div>
<p class="idhafatina-look-note"></p>
</div>
<div class="idhafatina-look-side">
<div class="idhafatina-fabrics" role="radiogroup" data-bka="aria-label|look_t6" aria-label="{{ trans('idhafatina.fam.' ~ bk ~ '_look_t6')|replace(sl) }}">
{% for o in outfits %}
<button type="button" class="fab{{ loop.first ? ' on' : '' }}" role="radio" aria-checked="{{ loop.first ? 'true' : 'false' }}"
data-name="{{ o.name }}" data-hex="{{ o.hex }}" data-match="{{ o.match }}" data-note="{{ o.note }}" data-bka="data-note|look_n{{ loop.index }};data-name|look_c{{ loop.index }}"{% if not is_def %} data-m{% endif %}>
<i style="background:{{ o.hex|default('#ccc') }}"></i><span data-bk="look_c{{ loop.index }}"{% if not is_def %} data-m{% endif %}>{{ o.name }}</span>
</button>
{% endfor %}
</div>
{% if component.dress_upload is not same as(false) %}
<div class="idhafatina-dress" data-idhafatina-dress>
<div class="idhafatina-dress-row">
<label class="idhafatina-dress-btn">
<input type="file" accept="image/*" class="idhafatina-dress-input" data-bka="aria-label|look_t2"{% if component.upload_label %} data-m{% endif %} aria-label="{{ component.upload_label|default(trans('idhafatina.fam.' ~ bk ~ '_look_t2')|replace(sl)) }}">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.6l1.2-1.8c.3-.4.7-.7 1.2-.7h3c.5 0 .9.3 1.2.7L15.9 6h1.6A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12.4" r="3.4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
<span data-bk="look_t2"{% if component.upload_label %} data-m{% endif %}>{{ component.upload_label|default(trans('idhafatina.fam.' ~ bk ~ '_look_t2')|replace(sl)) }}</span>
</label>
<label class="idhafatina-dress-btn idhafatina-dress-cam">
<input type="file" accept="image/*" capture="environment" class="idhafatina-dress-input" data-bka="aria-label|look_t3"{% if component.camera_label %} data-m{% endif %} aria-label="{{ component.camera_label|default(trans('idhafatina.fam.' ~ bk ~ '_look_t3')|replace(sl)) }}">
<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
<span data-bk="look_t4"{% if component.camera_label %} data-m{% endif %}>{{ component.camera_label|default(trans('idhafatina.fam.' ~ bk ~ '_look_t4')|replace(sl)) }}</span>
</label>
<span class="idhafatina-dress-or" data-bk="look_t7">{{ trans('idhafatina.fam.' ~ bk ~ '_look_t7')|replace(sl) }}</span>
</div>
<div class="idhafatina-dress-view" hidden>
<div class="idhafatina-dress-photo">
<span class="idhafatina-dress-frame">
<canvas data-bka="aria-label|look_t8" aria-label="{{ trans('idhafatina.fam.' ~ bk ~ '_look_t8')|replace(sl) }}"></canvas>
<span class="idhafatina-dress-pin" hidden></span>
</span>
</div>
<div class="idhafatina-dress-info">
<span class="idhafatina-eyebrow"><span class="latin k-ar-auto" data-bk="look_k">{{ trans('idhafatina.fam.' ~ bk ~ '_look_k')|replace(sl) }}</span></span>
<div class="idhafatina-dress-swatch"><i></i><div><b class="idhafatina-dress-title" data-bk="look_t9">{{ trans('idhafatina.fam.' ~ bk ~ '_look_t9')|replace(sl) }}</b><span class="idhafatina-dress-hex latin"></span></div></div>
<p class="idhafatina-dress-near"></p>
<p class="idhafatina-dress-fams" hidden></p>
<p class="idhafatina-dress-hint" data-bk="look_t10">{{ trans('idhafatina.fam.' ~ bk ~ '_look_t10')|replace(sl) }}</p>
<button type="button" class="idhafatina-dress-reset" data-bk="look_t11">{{ trans('idhafatina.fam.' ~ bk ~ '_look_t11')|replace(sl) }}</button>
</div>
</div>
<p class="idhafatina-dress-privacy"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span{% if component.privacy_note %} data-m data-dv="{{ trans('idhafatina.look.t5')|e }}"{% endif %}>{{ component.privacy_note|default(trans('idhafatina.look.t5')) }}</span></p>
</div>
{% endif %}
<div class="idhafatina-look-reco" aria-live="polite"></div>
<p class="idhafatina-fine"{% if component.fine %} data-m data-dv="{{ trans('idhafatina.look.t11')|e }}"{% endif %}>{{ component.fine|default(trans('idhafatina.look.t11')) }}</p>
</div>
</div>
</div>
<ul class="idhafatina-data" hidden>
{% for product in component.products|default([]) %}<li data-product="{{ product }}"></li>{% endfor %}
</ul>
{%include 'components.idhafatina-ks'%}
</section>
