{% set fk_t = theme.settings.get('idhafatina_store_type', 'auto') %}{% if fk_t is iterable %}{% set fk_t = fk_t.value is defined ? fk_t.value : fk_t|first %}{% endif %}{% if fk_t is iterable %}{% set fk_t = 'auto' %}{% endif %}{% set fk = {'abaya': 'fashion', 'fashion': 'fashion', 'jewelry': 'jewelry'}[fk_t]|default('gen') %}
{% set bg_ok = component.bg_color is not empty and component.bg_color is not iterable and component.bg_color matches '/^#[0-9a-fA-F]{3,8}$/' %}{% set tc_ok = component.text_color is not empty and component.text_color is not iterable and component.text_color matches '/^#[0-9a-fA-F]{3,8}$/' %}
<section component-id="{{ componentId }}" class="idhafatina-f idhafatina-ut" id="idhafatina-undertone" data-idhafatina-feature="undertone"{% if bg_ok %} style="background-color:{{ component.bg_color }}"{% endif %}>
<div class="idhafatina-wrap">
{% if not component.hide_header %}<header class="idhafatina-head center">
<span class="idhafatina-eyebrow">{% set kk = component.eyebrow|default(trans('idhafatina.fam.' ~ fk ~ '_undertone_e')) %}<span class="latin{{ kk matches '/[A-Za-z]/' ? '' : ' k-ar' }}" data-fk="undertone_e"{% if component.eyebrow %} data-m{% endif %}>{{ kk }}</span></span>
{%set tpk%}{%include 'components.idhafatina-tp' with {s:'undertone'}%}{%endset%}{%set tpk=tpk|split('¦')%}
<h2{% if tc_ok %} style="color:{{ component.text_color }}"{% endif %} data-fk="undertone_t"{% if component.title or tpk[1] is defined %} data-m{% endif %}{% if tpk[1] is defined %} data-tp="{{ tpk[0] }}"{% endif %}>{{ tpk[1] ?? component.title|default(trans('idhafatina.fam.' ~ fk ~ '_undertone_t')) }}</h2>
<p{% if tc_ok %} style="color:{{ component.text_color }}"{% endif %} data-fk="undertone_d"{% if component.description %} data-m{% endif %}>{{ component.description|default(trans('idhafatina.fam.' ~ fk ~ '_undertone_d')) }}</p>
</header>{% endif %}
<div class="idhafatina-ut-ui"></div>
</div>
</section>
